{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    ".probe/@package/**/*.d.ts",
    ".probe/@side-only/**/*.d.ts",
    ".probe/@special/**/*.d.ts"
  ]
}
